{
    "action": {
      "default_icon": {
         "128": "icon128.png",
         "16": "icon16.png",
         "32": "icon32.png",
         "48": "icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Wallpaper"
   },
   "background": {
      "scripts": [
         "background.js"
      ]
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "wallpaper@zentab.com",
         "strict_min_version": "109.0"
      }
   },
   "chrome_url_overrides": {
      "newtab": "newtab.html"
   },
   "commands": {
      "_execute_action": {
         "description": "Open Wallpaper",
         "suggested_key": {
            "default": "Ctrl+Shift+P"
         }
      }
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Wallpaper — A minimal, clean and modern new tab workspace with Todo lists, boards, and productivity widgets.",
   "host_permissions": [
      "https://api.open-meteo.com/*",
      "https://geocoding-api.open-meteo.com/*",
      "https://www.googleapis.com/*",
      "https://accounts.google.com/*",
      "https://*.gstatic.com/*",
      "https://icons.duckduckgo.com/*",
      "https://www.google-analytics.com/*"
   ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "manifest_version": 3,
   "name": "Wallpaper",
   "oauth2": {
      "client_id": "211731793063-qdamgoo5mq3mk38jro4o0ig059q9qjvu.apps.googleusercontent.com",
      "scopes": [
         "https://www.googleapis.com/auth/userinfo.email",
         "https://www.googleapis.com/auth/userinfo.profile"
      ]
   },
   "permissions": [
      "storage",
      "unlimitedStorage",
      "bookmarks",
      "identity",
      "activeTab",
      "tabs",
      "search"
   ],
   "version": "1.3.1",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "wallpapers/*"
         ]
      }
   ]
}